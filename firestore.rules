rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return isSignedIn() ? myProfile().role : null;
    }

    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------------------
    // users
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow create: if isOwner(userId)
                    && request.resource.data.verified == false
                    && request.resource.data.banned == false;
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isAdmin()
                    || (isOwner(userId)
                        && request.resource.data.verified == resource.data.verified
                        && request.resource.data.banned == resource.data.banned);
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // drivers
    // -------------------------------------------------------------------------
    match /drivers/{driverId} {
      allow create: if isOwner(driverId) && request.resource.data.verified == false;
      allow read: if isSignedIn();
      allow update: if isAdmin()
                    || (isOwner(driverId)
                        && request.resource.data.verified == resource.data.verified);
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // stores
    // -------------------------------------------------------------------------
    match /stores/{storeId} {
      allow read: if true;
      allow create: if isSignedIn() && myRole() == 'seller'
                    && request.resource.data.sellerId == request.auth.uid
                    && request.resource.data.verified == false;
      allow update: if isAdmin()
                    || (isSignedIn() && resource.data.sellerId == request.auth.uid
                        && request.resource.data.sellerId == resource.data.sellerId
                        && request.resource.data.verified == resource.data.verified);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.sellerId == request.auth.uid);
    }

    // -------------------------------------------------------------------------
    // products
    // -------------------------------------------------------------------------
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && myRole() == 'seller'
                    && get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.sellerId == request.auth.uid;
      allow update, delete: if isAdmin()
                    || (isSignedIn()
                        && get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.sellerId == request.auth.uid);
    }

    // -------------------------------------------------------------------------
    // orders + messages subcollection
    // -------------------------------------------------------------------------
    match /orders/{orderId} {
      allow create: if isSignedIn()
                    && request.resource.data.buyerId == request.auth.uid;

      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.buyerId == request.auth.uid)
                  || (isSignedIn() && resource.data.sellerId == request.auth.uid)
                  || (isSignedIn() && resource.data.driverId == request.auth.uid)
                  || (isSignedIn() && myRole() == 'driver' && resource.data.status == 'driver_requested');

      allow update: if isAdmin()
                  || (isSignedIn() && resource.data.buyerId == request.auth.uid)
                  || (isSignedIn() && resource.data.sellerId == request.auth.uid)
                  || (isSignedIn() && myRole() == 'driver'
                      && (resource.data.driverId == request.auth.uid || resource.data.status == 'driver_requested')
                      && get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.isActive == true);

      allow delete: if isAdmin();

      // Messages subcollection — only buyer and seller of this order can access
      match /messages/{msgId} {
        allow read, create: if isSignedIn()
                            && (get(/databases/$(database)/documents/orders/$(orderId)).data.buyerId == request.auth.uid
                                || get(/databases/$(database)/documents/orders/$(orderId)).data.sellerId == request.auth.uid
                                || isAdmin());
        allow update, delete: if isAdmin();
      }
    }

    // -------------------------------------------------------------------------
    // settings
    // -------------------------------------------------------------------------
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // listings
    // -------------------------------------------------------------------------
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin()
                            || (isSignedIn() && resource.data.postedBy == request.auth.uid);
    }

    // -------------------------------------------------------------------------
    // houses — rental/accommodation listings (publicly browsable)
    // -------------------------------------------------------------------------
    match /houses/{houseId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      // Chat messages — anyone can read/create (anonymous buyers included)
      match /chatMessages/{msgId} {
        allow read, create: if true;
        allow update, delete: if isAdmin();
      }
    }

    // -------------------------------------------------------------------------
    // houseBookings — booking requests submitted by visitors
    // -------------------------------------------------------------------------
    match /houseBookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // disputes
    // -------------------------------------------------------------------------
    match /disputes/{disputeId} {
      allow create: if isSignedIn() && request.resource.data.raisedBy == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.raisedBy == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
